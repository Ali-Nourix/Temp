{
  "name": "webp-convert",
  "version": "1.0.0",
  "description": "Convert very large TIFF/JPEG images into high-quality, web-ready WebP files.",
  "author": "Nourix",
  "type": "module",
  "main": "app/main.js",
  "bin": {
    "webp-convert": "./src/cli.js"
  },
  "scripts": {
    "start": "electron .",
    "convert": "node src/cli.js",
    "build": "electron-builder --win",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.nourix.webp-converter",
    "productName": "WebP Converter",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "src/**/*"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "WebP-Converter-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "WebP-Converter-${version}-portable.${ext}"
    }
  }
}
